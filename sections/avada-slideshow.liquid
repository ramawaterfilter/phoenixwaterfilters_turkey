{{ 'avada-slide-show-all.min.css' | asset_url | stylesheet_tag }}

<script src="{{ 'avada-slideshow.min.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign placeholder_image = section.settings.placeholder_image
  assign default_placeholder_image = "data:image/svg+xml;base64,"
%}


{%- if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
    #Avada-Slider-{{ section.id }}::before,
    #Avada-Slider-{{ section.id }} .avada-media::before,
    #Avada-Slider-{{ section.id }}:not(.avada-banner--mobile-bottom) .avada-banner__content::before {
    padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
    content: '';
    display: block;
    }
    }

    @media screen and (min-width: 750px) {
    #Avada-Slider-{{ section.id }}::before,
    #Avada-Slider-{{ section.id }} .avada-media::before {
    padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
    content: '';
    display: block;
    }
    }
  {%- endstyle -%}
{%- endif -%}

{%- if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.mobile_image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
    #Avada-Slider-{{ section.id }}::before,
    #Avada-Slider-{{ section.id }} .avada-media::before,
    #Avada-Slider-{{ section.id }}:not(.avada-banner--mobile-bottom) .avada-banner__content::before {
    padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.mobile_image.aspect_ratio | times: 100 }}%;
    content: '';
    display: block;
    }
    }
  {%- endstyle -%}
{%- endif -%}


<avada-slideshow-component
  class="avada-slider-mobile-gutter{% if section.settings.layout == 'grid' %} avada-page-width{% endif %}{% if section.settings.show_text_below %} avada-mobile-text-below{% endif %}"
  role="region"
  aria-label="{{ section.settings.accessibility_info | escape }}"
>
  {%- if section.settings.auto_rotate and section.blocks.size > 1 -%}
    <div
      class="avada-slideshow__controls avada-slideshow__controls--{{ section.settings.controls_position }} avada-slideshow__controls--top avada-slider-buttons no-js-hidden{% if section.settings.show_text_below %} avada-slideshow__controls--border-radius-mobile {% endif %}">
      <button
        type="button"
        class="avada-slider-button avada-slider-button--prev"
        name="previous"
        aria-controls="Avada-Slider-{{ section.id }}"
      >
        <svg aria-hidden="true" focusable="false" class="avada-icon avada-icon-caret" viewBox="0 0 10 6">
          <path fill-rule="evenodd" clip-rule="evenodd"
                d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z"
                fill="currentColor">
        </svg>

      </button>
      <div
        class="avada-slider-counter avada-slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
        {%- if section.settings.slider_visual == 'counter' -%}
          <span class="avada-slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="avada-visually-hidden"></span>
          <span class="avada-slider-counter--total">{{ section.blocks.size }}</span>
        {%- else -%}
          <div class="avada-slideshow__control-wrapper">
            {%- for block in section.blocks -%}
              <button
                class="avada-slider-counter__link avada-slider-counter__link--{{ section.settings.slider_visual }} avada-link"

                aria-controls="Avada-Slider-{{ section.id }}"
              >
                {%- if section.settings.slider_visual == 'numbers' -%}
                  {{ forloop.index -}}
                {%- else -%}
                  <span class="avada-dot"></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <button
        type="button"
        class="avada-slider-button avada-slider-button--next"
        name="next"
        aria-controls="Avada-Slider-{{ section.id }}"
      >
        <svg aria-hidden="true" focusable="false" class="avada-icon avada-icon-caret" viewBox="0 0 10 6">
          <path fill-rule="evenodd" clip-rule="evenodd"
                d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z"
                fill="currentColor">
        </svg>

      </button>

      {%- if section.settings.auto_rotate -%}
        <button
          type="button"
          class="avada-slideshow__autoplay avada-slider-button no-js-hidden{% if section.settings.auto_rotate == false %} avada-slideshow__autoplay--paused{% endif %}"
        >
          <svg
            class="avada-icon avada-icon-pause"
            viewBox="0 0 8 12"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            focusable="false"
            aria-hidden="true"
          >
            <path
              d="M1.2 0.75C0.813401 0.75 0.5 0.985051 0.5 1.275V10.725C0.5 11.0149 0.813401 11.25 1.2 11.25C1.5866 11.25 1.9 11.0149 1.9 10.725V1.275C1.9 0.985051 1.5866 0.75 1.2 0.75Z"
              fill="currentColor"/>
            <path
              d="M6.8 0.75C6.4134 0.75 6.1 0.985051 6.1 1.275V10.725C6.1 11.0149 6.4134 11.25 6.8 11.25C7.1866 11.25 7.5 11.0149 7.5 10.725V1.275C7.5 0.985051 7.1866 0.75 6.8 0.75Z"
              fill="currentColor"/>
          </svg>

          <svg
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            focusable="false"
            class="avada-icon avada-icon-play"
            fill="none"
            viewBox="0 0 10 14"
          >
            <path fill-rule="evenodd" clip-rule="evenodd"
                  d="M1.48177 0.814643C0.81532 0.448245 0 0.930414 0 1.69094V12.2081C0 12.991 0.858787 13.4702 1.52503 13.0592L10.5398 7.49813C11.1918 7.09588 11.1679 6.13985 10.4965 5.77075L1.48177 0.814643Z"
                  fill="currentColor"/>
          </svg>

        </button>
      {%- endif -%}
    </div>
    <noscript>
      <div class="avada-slider-buttons">
        <div class="avada-slider-counter">
          {%- for block in section.blocks -%}
            <a
              href="#Slide-{{ section.id }}-{{ forloop.index }}"
              class="avada-slider-counter__link avada-link"
            >
              {{ forloop.index }}
            </a>
          {%- endfor -%}
        </div>
      </div>
    </noscript>
  {%- endif -%}

  <div
    class="avada-skip avada-slideshow avada-banner avada-banner--{{ section.settings.slide_height }} avada-grid avada-grid--1-col avada-slider avada-slider--everywhere{% if section.settings.show_text_below %} avada-banner--mobile-bottom{% endif %}{% if section.blocks.first.settings.image == blank %} avada-slideshow--placeholder{% endif %}{% if settings.animations_reveal_on_scroll %} avada-scroll-trigger avada-animate--fade-in{% endif %}"
    id="Avada-Slider-{{ section.id }}"
    aria-live="polite"
    aria-atomic="true"
    data-autoplay="{{ section.settings.auto_rotate }}"
    data-speed="{{ section.settings.change_slides_speed }}"
  >
    <div
      class="avada-slideshow__slide avada-grid__item avada-grid--1-col avada-slider__slide"
      id="Avada-Slide-{{ section.id }}--1"
      {{ block.shopify_attributes }}
      role="group"
      tabindex="-1"
    >
      <div
        class="avada-slideshow__media avada-banner__media avada-media{% if block.settings.image == blank %} avada-placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
        <img loading="lazy"
          class="skip avada-hidden-md"
          width="100%"
          height="100%"
          style="pointer-events: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; max-width: 100%; max-height: 100%;"
          src="{% if placeholder_image == 'avada-placeholder-loader.webp' %}{{ placeholder_image | asset_url | append: '&width=600' }}{% elsif placeholder_image contains 'http' %}{{ placeholder_image }}{% else %}{{ default_placeholder_image }}{% endif %}"
          alt="large image mobile"
          fetchpriority="high"
        >
        <img loading="lazy"
          class="skip avada-hidden-sm"
          width="100%"
          height="100%"
          style="pointer-events: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; max-width: 100%; max-height: 100%;"
          src="{% if placeholder_image == 'avada-placeholder-loader.webp' %}{{ placeholder_image | asset_url | append: '&width=1920' }}{% elsif placeholder_image contains 'http' %}{{ placeholder_image }}{% else %}{{ default_placeholder_image }}{% endif %}"
          alt="large image"
        >
      </div>
    </div>

    {%- for block in section.blocks -%}
      <style>
        #Avada-Slide-{{ section.id }}-{{ forloop.index }} .avada-banner__media::after {
          opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};
        }

        #Avada-Slide-{{ section.id }}-{{ forloop.index }} .avada-banner__heading * {
          color: {{ block.settings.text_heading_color }};
          margin: 0;
          padding: 0;
        }
        #Avada-Slide-{{ section.id }}-{{ forloop.index }} .avada-banner__text * {
          color: {{ block.settings.text_subheading_color }};
          margin: 0;
          padding: 0;
        }
      </style>
      <div
        class="avada-slideshow__slide avada-grid__item avada-grid--1-col avada-slider__slide"
        id="Avada-Slide-{{ section.id }}-{{ forloop.index }}"
        {{ block.shopify_attributes }}
        role="group"
        tabindex="-1"
      >
        <div
          class="avada-slideshow__media avada-banner__media avada-media{% if block.settings.image == blank %} avada-placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
          {%- liquid
            assign has_mobile_image = false
            if block.settings.mobile_image != blank
              assign has_mobile_image = true
            endif

            assign has_image = false
            if block.settings.image != blank
              assign has_image = true
            endif
          -%}
          {%- if has_image -%}

            {%- liquid
              assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
              assign desktop_class = ''
              if has_mobile_image
                assign desktop_class = 'avada-hidden-sm'
              endif

              if section.settings.image_behavior == 'ambient'
                assign sizes = '120vw'
                assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
              else
                assign sizes = '100vw'
                assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
              endif -%}
            {{ block.settings.image | image_url: width: 3840 | image_tag: class: has_mobile_image, loading: 'lazy', height: height, sizes: sizes, widths: widths }}
          {%- endif -%}

          {%- if has_mobile_image -%}

            {%- liquid
              assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
              assign mobile_image_size = block.settings.mobile_image_size
              if section.settings.image_behavior == 'ambient'
                assign sizes = '120vw'
                assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
              else
                assign sizes = '100vw'
                assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
              endif -%}
            {{ block.settings.mobile_image | image_url: width: mobile_image_size | image_tag: class: 'avada-hidden-md', loading: 'lazy', height: height, sizes: sizes, widths: widths }}
          {%- endif -%}
        </div>
        {% unless section.settings.hide_box_content != false %}
          <div
            class="avada-slideshow__text-wrapper avada-banner__content avada-banner__content--{{ block.settings.box_align }} avada-page-width{% if block.settings.show_text_box == false %} avada-banner--desktop-transparent{% endif %}{% if settings.animations_reveal_on_scroll and forloop.index == 1 %} avada-scroll-trigger avada-animate--slide-in{% endif %}">
            <div
              style="background: {{ block.settings.box_background_color }}; border-radius: {{ block.settings.box_radius }}px; padding: {{ block.settings.box_padding }}"
              class="avada-slideshow__text avada-banner__box avada-content-container avada-content-container--full-width-mobile avada-color-{{ block.settings.color_scheme }} avada-gradient avada-slideshow__text--{{ block.settings.text_alignment }} avada-slideshow__text-mobile--{{ block.settings.text_alignment_mobile }} avada-slideshow__box-mobile--{{ block.settings.mobile_box_position }}">
              {%- if block.settings.heading != blank -%}
                <div style="color: {{ block.settings.text_heading_color }}" class="avada-banner__heading avada-inline-richtext">
                  {{ block.settings.heading }}
                </div>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <div class="avada-banner__text avada-rte" {{ block.shopify_attributes }}>
                  <div style="color: {{ block.settings.text_subheading_color }}">{{ block.settings.subheading }}</div>
                </div>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <div class="avada-banner__buttons">
                  <a
                    style="background: {{ block.settings.button_background_color }}; color: {{ block.settings.button_text_color }}; border-radius: {{ block.settings.button_radius }}px; padding: {{ block.settings.button_padding }}"
                    {% if block.settings.link %}
                      href="{{ block.settings.link }}"
                    {% else %}
                      role="link" aria-disabled="true"
                    {% endif %}
                    class="avada-button {% if block.settings.button_style_secondary %}avada-button--secondary{% else %}avada-button--primary{% endif %}"
                  >
                    {{- block.settings.button_label | escape -}}
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        {% endunless %}

      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 and section.settings.auto_rotate == false -%}
    <div
      class="avada-slideshow__controls avada-slideshow__controls--{{ section.settings.controls_position }} avada-slider-buttons no-js-hidden{% if section.settings.show_text_below %} avada-slideshow__controls--border-radius-mobile{% endif %}">
      <button
        type="button"
        class="avada-slider-button avada-slider-button--prev"
        name="avada-previous"
        aria-controls="Avada-Slider-{{ section.id }}"
      >
        <svg aria-hidden="true" focusable="false" class="avada-icon avada-icon-caret" viewBox="0 0 10 6">
          <path fill-rule="evenodd" clip-rule="evenodd"
                d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z"
                fill="currentColor">
        </svg>

      </button>
      <div
        class="avada-slider-counter avada-slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} avada-caption{% endif %}">
        {%- if section.settings.slider_visual == 'counter' -%}
          <span class="avada-slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="avada-visually-hidden"> </span>
          <span class="avada-slider-counter--total">{{ section.blocks.size | minus: 1 }}</span>
        {%- else -%}
          <div class="avada-slideshow__control-wrapper">
            {%- for block in section.blocks -%}
              <button
                class="avada-slider-counter__link avada-slider-counter__link--{{ section.settings.slider_visual }} avada-link"
                aria-controls="Avada-Slider-{{ section.id }}"
              >
                {%- if section.settings.slider_visual == 'numbers' -%}
                  {{ forloop.index -}}
                {%- else -%}
                  <span class="avada-dot"></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <button
        type="button"
        class="avada-slider-button avada-slider-button--next"
        name="avada-next"
        aria-controls="Avada-Slider-{{ section.id }}"
      >
        <svg aria-hidden="true" focusable="false" class="avada-icon avada-icon-caret" viewBox="0 0 10 6">
          <path fill-rule="evenodd" clip-rule="evenodd"
                d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z"
                fill="currentColor">
        </svg>

      </button>

      {%- if section.settings.auto_rotate -%}
        <button
          type="button"
          class="avada-slideshow__autoplay avada-slider-button no-js-hidden{% if section.settings.auto_rotate == false %} avada-slideshow__autoplay--paused{% endif %}"
        >
          <svg
            class="avada-icon avada-icon-pause"
            viewBox="0 0 8 12"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            focusable="false"
            aria-hidden="true"
          >
            <path
              d="M1.2 0.75C0.813401 0.75 0.5 0.985051 0.5 1.275V10.725C0.5 11.0149 0.813401 11.25 1.2 11.25C1.5866 11.25 1.9 11.0149 1.9 10.725V1.275C1.9 0.985051 1.5866 0.75 1.2 0.75Z"
              fill="currentColor"/>
            <path
              d="M6.8 0.75C6.4134 0.75 6.1 0.985051 6.1 1.275V10.725C6.1 11.0149 6.4134 11.25 6.8 11.25C7.1866 11.25 7.5 11.0149 7.5 10.725V1.275C7.5 0.985051 7.1866 0.75 6.8 0.75Z"
              fill="currentColor"/>
          </svg>

          <svg
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            focusable="false"
            class="avada-icon avada-icon-play"
            fill="none"
            viewBox="0 0 10 14"
          >
            <path fill-rule="evenodd" clip-rule="evenodd"
                  d="M1.48177 0.814643C0.81532 0.448245 0 0.930414 0 1.69094V12.2081C0 12.991 0.858787 13.4702 1.52503 13.0592L10.5398 7.49813C11.1918 7.09588 11.1679 6.13985 10.4965 5.77075L1.48177 0.814643Z"
                  fill="currentColor"/>
          </svg>
        </button>
      {%- endif -%}
    </div>
    <noscript>
      <div class="avada-slider-buttons">
        <div class="avada-slider-counter">
          {%- for block in section.blocks -%}
            <a
              href="#Avada-Slide-{{ section.id }}-{{ forloop.index }}"
              class="avada-slider-counter__link avada-link"
            >
              {{ forloop.index }}
            </a>
          {%- endfor -%}
        </div>
      </div>
    </noscript>
  {%- endif -%}
</avada-slideshow-component>

{% schema %}
{
  "name": "Avada Slideshow",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "placeholder_image",
      "label": "Placeholder Image",
      "default": "avada-placeholder-loader.webp"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "full_bleed",
          "label": "Full width"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "full_bleed",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "slide_height",
      "options": [
        {
          "value": "adapt_image",
          "label": "Adapt to first image"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "adapt_image",
      "label": "Adapt to first image"
    },
    {
      "type": "select",
      "id": "slider_visual",
      "options": [
        {
          "value": "dots",
          "label": "Dots"
        },
        {
          "value": "numbers",
          "label": "Numbers"
        }
      ],
      "default": "dots",
      "label": "Counter"
    },
    {
      "type": "select",
      "id": "controls_position",
      "options": [
        {
          "value": "bottom-center",
          "label": "Bottom Center"
        },
        {
          "value": "bottom-left",
          "label": "Bottom Left"
        },
        {
          "value": "bottom-right",
          "label": "Bottom Right"
        }
      ],
      "default": "bottom-center",
      "label": "Controls position"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate slides",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_box_content",
      "label": "Hide box content",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 9,
      "step": 2,
      "unit": "s",
      "label": "Change slides every",
      "default": 5
    },
    {
      "type": "header",
      "content": "Animations"
    },
    {
      "type": "select",
      "id": "image_behavior",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "ambient",
          "label": "Ambient Move"
        }
      ],
      "default": "none",
      "label": "Image behavior"
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "checkbox",
      "id": "show_text_below",
      "label": "Show content below images on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "Slideshow about our brand",
      "info": "Describe the slideshow for customers using screen readers.",
      "default": "Slideshow about our brand"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Image Slide",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image"
        },
        {
          "type": "number",
          "id": "mobile_image_size",
          "label": "Mobile Image Size",
          "default": 400
        },
        {
          "type": "richtext",
          "id": "heading",
          "default": "<h2>Image slide</h2>",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "subheading",
          "default": "<p>Tell your brand's story through images<p>",
          "label": "Subheading"
        },
        {
          "type": "inline_richtext",
          "id": "button_label",
          "default": "Button label",
          "label": "Button label",
          "info": "Leave the label blank to hide the button."
        },
        {
          "type": "number",
          "id": "button_radius",
