async function fetchExchangeRate(selectedCurrency) {
 try {
 // Replace with your preferred API and API key
 const response = await fetch(`https://openexchangerates.org/api/latest.json?app_id=b885266a1ff8425f907bbeba2ddccdfc`);
 const data = await response.json();
 // Get the exchange rate for the selected currency
 const rate = data.rates[selectedCurrency];
 if (!rate) throw new Error("Currency rate not found.");
 return rate;
 } catch (error) {
 console.error("Failed to fetch exchange rate:", error);
 return null; // Return null if API call fails
 }
}
