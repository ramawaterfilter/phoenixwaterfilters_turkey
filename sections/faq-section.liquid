<!-- faq-section.liquid -->

<div class="faq-section">
  <h2>{{ section.settings.faq_title }}</h2>

  <!-- Search Bar -->
  <div class="faq-search">
    <input type="text" id="faq-search-input" placeholder="Search FAQs..." />
    <button type="button" id="faq-search-button">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M21 21L15 15M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <!-- FAQ Items -->
  <div id="faq-items">
    {% for block in section.blocks %}
      <div class="faq-item" data-faq-item>
        <h3>{{ block.settings.question }}</h3>
        <p>{{ block.settings.answer }}</p>
      </div>
    {% endfor %}
  </div>
</div>

<!-- JavaScript for search functionality -->
<script>
  document.getElementById('faq-search-input').addEventListener('input', function() {
    let query = this.value.toLowerCase();
    let faqItems = document.querySelectorAll('[data-faq-item]');
    
    faqItems.forEach(function(item) {
      let question = item.querySelector('h3').innerText.toLowerCase();
      let answer = item.querySelector('p').innerText.toLowerCase();
      
      if (question.includes(query) || answer.includes(query)) {
        item.style.display = "block";
      } else {
        item.style.display = "none";
      }
    });
  });
</script>

<style>
  .faq-section {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
  }

  .faq-search {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
  }

  .faq-search input {
    flex: 1;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
  }

  .faq-search button {
    background: none;
    border: none;
    padding: 10px;
    cursor: pointer;
  }

  .faq-item {
    margin-bottom: 20px;
  }

  .faq-item h3 {
    margin: 0;
    font-size: 18px;
    font-weight: bold;
  }

  .faq-item p {
    margin: 5px 0 0;
  }
</style>

{% schema %}
{
  "name": "FAQ Section",
  "settings": [
    {
      "type": "text",
      "id": "faq_title",
      "label": "FAQ Section Title",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Section",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
