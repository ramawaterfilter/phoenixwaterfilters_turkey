 <script>
 document.addEventListener('DOMContentLoaded', function() {
 const carouselTrack = document.querySelector('.auto-carousel-track');
 const carouselDots = document.querySelectorAll('.auto-carousel-dot');
 const carouselSlides = document.querySelectorAll('.auto-carousel-slide');
 let autoCarouselIndex = 0;
 let slideWidth = carouselSlides[0].clientWidth;
 let autoScrollInterval;

 // Initialize carousel
 updateAutoCarousel();

 // Update slide width on window resize
 window.addEventListener('resize', function() {
 slideWidth = carouselSlides[0].clientWidth;
 updateAutoCarousel();
 });

 function updateAutoCarousel() {
 slideWidth = carouselSlides[0].clientWidth;
 carouselTrack.style.transform = `translateX(-${autoCarouselIndex * slideWidth}px)`;
 carouselDots.forEach(dot => dot.classList.remove('active'));
 carouselDots[autoCarouselIndex].classList.add('active');
 }

 function autoScrollCarousel() {
 autoCarouselIndex = (autoCarouselIndex + 1) % carouselDots.length;
 updateAutoCarousel();
 }

 carouselDots.forEach(dot => {
 dot.addEventListener('click', (e) => {
 autoCarouselIndex = parseInt(e.target.getAttribute('data-slide'));
 updateAutoCarousel();
 
 // Reset the interval when manually changing slides
 clearInterval(autoScrollInterval);
 startAutoScroll();
 });
 });

 // Start auto-scrolling function
 function startAutoScroll() {
 autoScrollInterval = setInterval(autoScrollCarousel, 3000);
 }
 
 // Initialize auto-scrolling
 startAutoScroll();
 
 // Pause auto-scroll when hovering over carousel
 const carouselContainer = document.querySelector('.auto-carousel-container');
 carouselContainer.addEventListener('mouseenter', () => {
 clearInterval(autoScrollInterval);
 });
 
 carouselContainer.addEventListener('mouseleave', () => {
 startAutoScroll();
 });
 });
 </script>
