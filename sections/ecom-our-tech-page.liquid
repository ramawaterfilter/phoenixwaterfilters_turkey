<script>
 const carouselTrack = document.querySelector('.auto-carousel-track');
 const carouselDots = document.querySelectorAll('.auto-carousel-dot');
 let autoCarouselIndex = 0;

 function updateAutoCarousel() {
 const slideWidth = document.querySelector('.auto-carousel-slide').clientWidth;
 carouselTrack.style.transform = `translateX(-${autoCarouselIndex * slideWidth}px)`;
 carouselDots.forEach(dot => dot.classList.remove('active'));
 carouselDots[autoCarouselIndex].classList.add('active');
 }

 function autoScrollCarousel() {
 autoCarouselIndex = (autoCarouselIndex + 1) % carouselDots.length;
 updateAutoCarousel();
 }

 carouselDots.forEach(dot => {
 dot.addEventListener('click', (e) => {
 autoCarouselIndex = parseInt(e.target.getAttribute('data-slide'));
 updateAutoCarousel();
 });
 });

 setInterval(autoScrollCarousel, 3000); // Change slides every 3 seconds
</script>
