 <script>
 const uniqueVideoItems = document.querySelectorAll('.unique-video-card');
 const uniquePreviousArrow = document.querySelector('.unique-video-prev');
 const uniqueNextArrow = document.querySelector('.unique-video-next');
 const uniqueVideos = document.querySelectorAll('.unique-video-card video');
 let uniqueCurrentIndex = 0;
 const uniqueItemsToShow = 1; // Show 1 video at a time

 function uniqueUpdateVisibleVideos() {
 uniqueVideoItems.forEach((item, index) => {
 item.style.display = (index >= uniqueCurrentIndex && index < uniqueCurrentIndex + uniqueItemsToShow) ? 'flex' : 'none';
 });
 uniquePreviousArrow.disabled = uniqueCurrentIndex === 0;
 uniqueNextArrow.disabled = uniqueCurrentIndex >= uniqueVideoItems.length - uniqueItemsToShow;
 }

 function uniqueNextVideo() {
 if (uniqueCurrentIndex < uniqueVideoItems.length - uniqueItemsToShow) {
 uniqueCurrentIndex++;
 uniqueUpdateVisibleVideos();
 }
 }

 function uniquePreviousVideo() {
 if (uniqueCurrentIndex > 0) {
 uniqueCurrentIndex--;
 uniqueUpdateVisibleVideos();
 }
 }

 function uniquePauseOtherVideos(currentVideo) {
 uniqueVideos.forEach(video => {
 if (video !== currentVideo) {
 video.pause();
 }
 });
 }

 uniqueVideos.forEach(video => {
 video.addEventListener('play', () => uniquePauseOtherVideos(video));
 });

 uniqueUpdateVisibleVideos();
 </script>
