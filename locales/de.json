      "text0_ei1y1igytv_html": "Unsere POSTreat Fluorid-Entfernungskartusche",
      "title0_h4gozfvf1f6_html": "Leben filtern ",
      "text0_h4gozfvf1f6_html": "Bis zu 20.000 Liter",
      "title0_i2wf5vxswae_html": "Mach es selbst",
      "text0_i2wf5vxswae_html": "Einfache Installation, keine Klempnerarbeiten, Selbstaustausch",
      "title0_1nm6by565uo_html": "Chemikalien frei",
      "text0_1nm6by565uo_html": " Es sind keine Chemikalien erforderlich",
      "title0_ld7qudvcf6_html": "Viren 99,9 %",
      "title0_em1z72fs3pv_html": "Parasiten 99,9 %",
