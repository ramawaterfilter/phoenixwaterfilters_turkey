            "headingtext_tewlld6ill_html": "What\u2019s in the box?",
            "textcontent_yu829nbfbu_html": "<ul><li>1 x 304-grade Stainless Steel housing unit<\/li><li> 1 x 304-grade Stainless Steel tap<br><\/li><li> 2 x Smart Carbon cartridges<br><\/li><\/ul>",
            "headingtext_a6trs2n2jv_html": "Optional extras:",
            "text_week_tus8q6qwyt_html": "[%-W] week%!W",
            "text_day_tus8q6qwyt_html": "[%-d] day%!D",
            "text_hour_tus8q6qwyt_html": "[%-H] hr%!H",
