      "headingtext_d7imxc49j8_html": "<h3 class=\"ecom__heading ecom-db\" style=\"font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 800; font-family: Lato, sans-serif; font-size: 18px; color: rgb(38, 34, 40); letter-spacing: normal; text-align: center;\">Pacote Phoenix Gravity Classic</h3>",
      "headingtext_hoc39zhqixf_html": "Complementos adicionais:",
