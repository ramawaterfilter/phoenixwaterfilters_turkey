            "title2_hpxa3t0svqo_html": "ve \u00e7ok daha fazlas\u0131",
            "headingtext_9ce3rla4wna_html": "\u00d6nemli \u015feyleri <font color=\"#4994bf\">korurken<\/font>\n mineraller",
