            "item_title_0_obyhwb3w3en_html": "Hangi boyut filtre benim i\u00e7in en iyisidir?",
            "item_title_1_obyhwb3w3en_html": "Filtremi temizleyebilir miyim?",
            "product_option_swatch_98whhm7ikj_html": "Renk",
